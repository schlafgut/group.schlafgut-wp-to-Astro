---
export const prerender = true;

/**
 * Dynamic Job Detail Page from Content Collection
 * Uses ColumnsWithHeadline component for proper styling
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroTextJobs from '../../components/sections/HeroTextJobs.astro';
import ColumnsWithHeadline from '../../components/sections/ColumnsWithHeadline.astro';
import GridBlocks from '../../components/sections/GridBlocks.astro';
import GridBlock from '../../components/sections/GridBlock.astro';
import FullBleedBlocks from '../../components/sections/FullBleedBlocks.astro';
import FullBleedBlock from '../../components/sections/FullBleedBlock.astro';
import workLifeImage from '../../assets/images/work_life_wide-1680x925.jpeg';
import historieImage from '../../assets/images/Bildschirmfoto-2021-01-26-um-14.17-3-1680x2249.jpg';
import produktionImage from '../../assets/images/DSC2016-7-1680x2249.jpg';
import produkteImage from '../../assets/images/Bildschirmfoto-2021-01-26-um-14.17-5-1-1680x2249.jpg';
import auszeichnetImage from '../../assets/images/DSC2016-8-1680x2249.jpg';

export async function getStaticPaths() {
  const jobs = await getCollection('jobs', ({ data }) => data.published);
  return jobs.map((job) => ({
    params: { slug: job.slug },
    props: { job },
  }));
}

const { job } = Astro.props;

const employmentTypeLabels: Record<string, string> = {
  vollzeit: 'Vollzeit',
  teilzeit: 'Teilzeit',
  werkstudent: 'Werkstudent',
  praktikum: 'Praktikum',
};

// Convert multiline text to HTML with list items
function textToHtml(text: string | undefined): string {
  if (!text) return '';

  // Split into lines and process
  const lines = text.split('\n').filter(line => line.trim());

  // Check if lines start with - or * (list items)
  const hasList = lines.some(line => /^[-*•]\s/.test(line.trim()));

  if (hasList) {
    const items = lines.map(line => {
      // Remove leading - or * and trim
      const content = line.replace(/^[-*•]\s*/, '').trim();
      // Convert **bold** to <strong>
      const withBold = content.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      return `<li>${withBold}</li>`;
    }).join('\n');
    return `<ul>\n${items}\n</ul>`;
  }

  // Otherwise treat as paragraphs
  return lines.map(line => {
    const withBold = line.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    return `<p>${withBold}</p>`;
  }).join('\n');
}

// Build sections for tasks and requirements (beige background)
const beigeSections = [];

if (job.data.tasks) {
  beigeSections.push({
    headline: 'Deine Aufgaben',
    content: textToHtml(job.data.tasks),
  });
}

if (job.data.requirements) {
  beigeSections.push({
    headline: 'Was bringst<br />du mit?',
    content: textToHtml(job.data.requirements),
  });
}

// Build benefits section (yellow background)
const yellowSections = [];

if (job.data.benefits) {
  yellowSections.push({
    headline: 'Warum wir?',
    content: textToHtml(job.data.benefits) + `
      <p style="margin-top: 2rem;">Interesse? Dann bewirb Dich und sende deine Unterlagen an:<br />
      <a href="mailto:${job.data.contactEmail}">${job.data.contactEmail}</a></p>
      <p><a href="mailto:${job.data.contactEmail}" class="cta__button">jetzt bewerben</a></p>
    `,
  });
}

// Shared footer blocks for all job pages
const sharedFullBleedBlocks = [
  {
    href: '/unsere-historie/',
    title: 'Unsere Historie',
    image: historieImage,
  },
  {
    href: '/unsere-produktion/',
    title: 'Unsere Produktion',
    image: produktionImage,
  },
  {
    href: '/produkte-entdecken/',
    title: 'Produkte entdecken',
    image: produkteImage,
  },
  {
    href: '/was-uns-ausmacht/',
    title: 'was uns ausmacht',
    image: auszeichnetImage,
  },
];
---

<BaseLayout
  title={`${job.data.title} | schlafgut`}
  currentPath={Astro.url.pathname}
  headerVariant="yellow"
>
  <HeroTextJobs
    title={`${job.data.title}<br />${job.data.gender}`}
    subtitle={`${employmentTypeLabels[job.data.employmentType]}, ${job.data.location}`}
  />

  {beigeSections.length > 0 && (
    <ColumnsWithHeadline
      background="beige"
      lines={beigeSections}
    />
  )}

  {yellowSections.length > 0 && (
    <ColumnsWithHeadline
      background="yellow"
      lines={yellowSections}
    />
  )}

  <GridBlocks variant="fullwidth">
    <GridBlock
      variant="wide"
      headline="plantin"
      position="top"
      color="black"
      title="Work-Life-Balance ist bei uns keine Phrase."
      image={{
        src: workLifeImage.src,
        width: workLifeImage.width,
        height: workLifeImage.height,
      }}
    />
  </GridBlocks>

  <FullBleedBlocks>
    {sharedFullBleedBlocks.map((block) => (
      <FullBleedBlock
        href={block.href}
        title={block.title}
        image={{
          src: block.image.src,
          width: block.image.width,
          height: block.image.height,
        }}
      />
    ))}
  </FullBleedBlocks>
</BaseLayout>
