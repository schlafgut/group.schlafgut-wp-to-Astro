---
export const prerender = true;

/**
 * Dutch Homepage
 * Different structure from German homepage:
 * HeroText > FullwidthImage > ColumnsWithHeadline > ThreeImages > Quote > ColumnsWithHeadline > GridBlocks > FullBleedBlocks
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroText from '../../components/sections/HeroText.astro';
import FullwidthImage from '../../components/sections/FullwidthImage.astro';
import ColumnsWithHeadline from '../../components/sections/ColumnsWithHeadline.astro';
import ThreeImages from '../../components/sections/ThreeImages.astro';
import QuoteOnBackground from '../../components/sections/QuoteOnBackground.astro';
import GridBlocks from '../../components/sections/GridBlocks.astro';
import GridBlock from '../../components/sections/GridBlock.astro';
import FullBleedBlocks from '../../components/sections/FullBleedBlocks.astro';
import FullBleedBlock from '../../components/sections/FullBleedBlock.astro';
import { homepageContent } from '../../i18n/content/homepage';

const content = homepageContent.nl;
---

<BaseLayout
  title={content.meta.title}
  description={content.meta.description}
>
  {content.heroText && (
    <HeroText>
      <h1 set:html={content.heroText.title} />
      {content.heroText.paragraph && <p>{content.heroText.paragraph}</p>}
    </HeroText>
  )}

  {content.fullwidthImage && (
    <FullwidthImage
      video={content.fullwidthImage.video}
    />
  )}

  {content.columnsWithHeadline && content.columnsWithHeadline[0] && (
    <ColumnsWithHeadline
      background={content.columnsWithHeadline[0].background}
      lines={content.columnsWithHeadline[0].lines}
    />
  )}

  {content.threeImages && (
    <ThreeImages images={content.threeImages} />
  )}

  {content.quote && (
    <QuoteOnBackground
      quote={content.quote.text}
      author={content.quote.author}
    />
  )}

  {content.columnsWithHeadline && content.columnsWithHeadline[1] && (
    <ColumnsWithHeadline
      background={content.columnsWithHeadline[1].background}
      lines={content.columnsWithHeadline[1].lines}
    />
  )}

  {content.gridBlocksSections && content.gridBlocksSections[0] && (
    <GridBlocks variant={content.gridBlocksSections[0].variant}>
      {content.gridBlocksSections[0].blocks.map((block) => (
        <GridBlock
          variant={block.variant}
          headline={block.headline}
          position={block.position}
          color={block.color}
          kicker={block.kicker}
          title={block.title}
          link={block.link}
          image={block.image}
          video={block.video}
        />
      ))}
    </GridBlocks>
  )}

  {content.fullBleedBlocks && content.fullBleedBlocks.length > 0 && (
    <FullBleedBlocks>
      {content.fullBleedBlocks.map((block) => (
        <FullBleedBlock
          href={block.href}
          title={block.title}
          image={block.image}
        />
      ))}
    </FullBleedBlocks>
  )}
</BaseLayout>
