<script>
  // Sticky navigation on scroll
  const fixedNav = document.querySelector(".fixed__nav");
  const header = document.querySelector("header");

  const mediaQueryMobile = window.matchMedia("(max-width: 1024px)");

  let position = window.scrollY;

  window.addEventListener("scroll", () => {
    if (!mediaQueryMobile.matches) {
      const header = document.querySelector("header");
      if (!header) return;

      const headerHeight = header.offsetHeight;

      if (window.scrollY > headerHeight) {
        const current = window.scrollY;
        const fixedNav = document.querySelector(".fixed__nav");

        if (!fixedNav) return;

        if (current > position) {
          fixedNav.classList.remove("show"); // scrolling down
        } else {
          fixedNav.classList.add("show"); // scrolling up
        }

        position = current;
      } else {
        document.querySelector(".fixed__nav")?.classList.remove("show");
      }
    }
  });

  // Mobile menu toggle (placeholder - full implementation in Phase 4)
  const burger = document.querySelector(".burger");
  if (burger) {
    burger.addEventListener("click", () => {
      // TODO: Implement mobile menu in optimization phase
      console.log("Mobile menu toggled");
    });
  }
</script>
