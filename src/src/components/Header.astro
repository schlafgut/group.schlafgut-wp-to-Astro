---
import Logo from "./Logo.astro";
import Button from "./Button.astro";
// LanguageSwitcher deaktiviert - nur DE aktiv (2026-01-11)
// import LanguageSwitcher from './LanguageSwitcher.astro';
import Navigation from "./Navigation.astro";
import { getLangFromUrl } from "../i18n/utils";
import { ui } from "../i18n/navigation";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const homeHref = lang === "de" ? "/" : `/${lang}/`;
const t = ui[lang];
---

<header>
  <div class="header__top">
    <div class="innerwrapper smaller">
      <div class="header__left">
        {/* LanguageSwitcher deaktiviert - nur DE aktiv */}
        <a
          href="https://business.schlafgut.com/account/login"
          target="_blank"
          class="b2b-link"
        >
          {t.b2bShop}
        </a>
      </div>

      <a href={homeHref} class="logo" aria-label="Schlafgut Homepage">
        <Logo variant="full" />
      </a>

      <div class="header__right">
        <Button href="https://www.schlafgut.com" target="_blank" variant="shop">
          {t.shopNow}
        </Button>
      </div>

      {/* LanguageSwitcher mobile deaktiviert - nur DE aktiv */}

      <button class="burger" aria-label="Menu" type="button">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="30"
          height="30"
          viewBox="0 0 30 30"
        >
          <g fill="none" fill-rule="evenodd" stroke="#000">
            <path class="top-stroke" d="M0 11.5h30"></path>
            <path class="middle-stroke" d="M0 15.003h30"></path>
            <path class="bottom-stroke" d="M0 18.507h30"></path>
          </g>
        </svg>
      </button>
    </div>
  </div>
  <Navigation currentPath={currentPath} />
</header>

<div class="fixed__nav">
  <Navigation currentPath={currentPath} />
</div>

