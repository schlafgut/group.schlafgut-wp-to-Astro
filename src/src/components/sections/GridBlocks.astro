---
interface Props {
  variant?: "boxed" | "fullwidth";
  class?: string;
  animate?: boolean;
}

const { variant = "boxed", class: className = "", animate = true } = Astro.props;
---

<section class:list={["section__grid-blocks", variant, "default", className, { "stagger-container": animate }]}>
  <div class="innerwrapper smaller">
    <slot />
  </div>
</section>
