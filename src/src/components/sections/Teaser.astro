---
import Image from '../Image.astro';

interface Props {
  href: string;
  target?: '_blank' | '_self';
  kicker?: string;
  title?: string;
  image?: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    srcset?: string;
  };
}

const { href, target = '_self', kicker, title, image } = Astro.props;
---

<a href={href} target={target} class="teaser">
  {image && (
    <div class="image">
      <Image
        src={image.src}
        alt={image.alt || ''}
        width={image.width}
        height={image.height}
        srcset={image.srcset}
      />
    </div>
  )}
  <div class="content">
    {kicker && <h4 set:html={kicker} />}
    {title && <h3 set:html={title} />}
  </div>
</a>

<style>
  .teaser {
    display: block;
    text-decoration: none;
    color: var(--colorBlack);
  }

  .teaser .image {
    width: 100%;
    padding-bottom: 70%;
    border-radius: var(--borderRadius);
    overflow: hidden;
    position: relative;
  }

  .teaser .image :global(img) {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .teaser .content {
    padding: 1.4rem 0.9rem 0 0.9rem;
  }

  @media (max-width: 768px) {
    .teaser .content {
      padding-top: 0.8rem;
    }
  }

  .teaser h4 {
    font-family: "Agrandir", sans-serif;
    font-size: var(--fontSize10);
    line-height: 1.3;
    letter-spacing: 0.3em;
    text-align: left;
    margin: 0;
    font-weight: 500;
    text-transform: uppercase;
    margin-bottom: 1em;
  }

  @media (max-width: 768px) {
    .teaser h4 {
      font-size: var(--fontSize8);
    }
  }

  .teaser h3 {
    font-family: "PlantinMTPro", serif;
    font-size: var(--fontSize32);
    font-weight: 300;
    line-height: 1.125;
    text-align: left;
    margin: 0;
  }

  @media (max-width: 768px) {
    .teaser h3 {
      font-size: var(--fontSize22);
    }
  }
</style>
