---
import Image from "../Image.astro";

interface Props {
  href: string;
  target?: "_blank" | "_self";
  kicker?: string;
  title?: string;
  image?: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    srcset?: string;
  };
}

const { href, target = "_self", kicker, title, image } = Astro.props;
---

<a href={href} target={target} class="teaser slide-in-element">
  {
    image && (
      <div class="image">
        <Image
          src={image.src}
          alt={image.alt || ""}
          width={image.width}
          height={image.height}
          srcset={image.srcset}
        />
      </div>
    )
  }
  <div class="content">
    {kicker && <h4 set:html={kicker} />}
    {title && <h3 set:html={title} />}
  </div>
</a>
