---
import Image from "../Image.astro";

interface Props {
  reversed?: boolean;
  fullBleed?: boolean;
  noMargin?: boolean;
  background?: "default" | "yellow" | "beige";
  content: string;
  image?: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    srcset?: string;
  };
  video?: {
    src: string;
    width?: number;
    height?: number;
  };
  class?: string;
}

const {
  reversed = false,
  fullBleed = false,
  noMargin = false,
  background = "default",
  content,
  image,
  video,
  class: className = "",
} = Astro.props;

const classes = [
  "section__text-image",
  reversed && "reversed",
  fullBleed && "full-bleed",
  noMargin ? "no-margin" : "default",
  className,
].filter(Boolean);
---

<section class:list={classes} data-background={background}>
  <div class="innerwrapper smaller">
    <div class="content">
      <Fragment set:html={content} />
    </div>
    <div class="image">
      {
        video ? (
          <video
            class="lazy"
            width={video.width || 1080}
            height={video.height || 1080}
            autoplay
            loop
            muted
            playsinline
            aria-label="Dekoratives Video"
          >
            <source data-src={video.src} type="video/mp4" />
          </video>
        ) : image ? (
          <Image
            src={image.src}
            alt={image.alt || ""}
            width={image.width}
            height={image.height}
            srcset={image.srcset}
          />
        ) : null
      }
    </div>
  </div>
</section>
