---
interface ColumnLine {
  question: string;
  answer: string;
  video?: {
    src: string;
    width?: number;
    height?: number;
    style?: string;
  };
}

interface Props {
  lines: ColumnLine[];
  class?: string;
}

const { lines, class: className = '' } = Astro.props;
---

<section class:list={['section__interview-columns', 'default', className]}>
  <div class="innerwrapper smaller">
    {lines.map((line) => (
      <div class="column__line">
        <div class="column">
          <h3 set:html={line.question} />
          {line.video && (
            <div class="inner-video" style={line.video.style}>
              <video class="lazy" width={line.video.width} height={line.video.height} autoplay loop muted playsinline>
                <source data-src={line.video.src} type="video/mp4" />
              </video>
            </div>
          )}
        </div>
        <div class="column">
          <Fragment set:html={line.answer} />
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .section__interview-columns {
    --additionalSpacingTop: 2rem;
    --additionalSpacingBottom: 2rem;
  }

  @media (max-width: 768px) {
    .section__interview-columns {
      --additionalSpacingTop: 1rem;
      --additionalSpacingBottom: 1rem;
    }
  }

  .section__interview-columns .innerwrapper {
    display: flex;
    flex-direction: column;
    gap: 7.6rem 0;
  }

  @media (max-width: 768px) {
    .section__interview-columns .innerwrapper {
      gap: 4.5rem 0;
    }
  }

  .section__interview-columns .innerwrapper .column__line {
    display: grid;
    grid-template-columns: 0.95fr 1fr;
    gap: 0 3.4rem;
    text-align: left;
  }

  @media (max-width: 768px) {
    .section__interview-columns .innerwrapper .column__line {
      grid-template-columns: 100%;
      gap: 1.4rem 0;
    }
  }

  .section__interview-columns .innerwrapper .column__line .column {
    font-family: "PlantinMTPro", serif;
    font-size: var(--fontSize24);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-align: left;
  }

  @media (max-width: 768px) {
    .section__interview-columns .innerwrapper .column__line .column {
      font-size: var(--fontSize17);
      line-height: 1.44;
    }
  }

  .section__interview-columns .innerwrapper .column__line .column .inner-video {
    margin-top: 2rem;
    max-width: var(--width, 100%);
  }

  @media (max-width: 768px) {
    .section__interview-columns .innerwrapper .column__line .column .inner-video {
      margin-top: 1rem;
    }
  }

  .section__interview-columns .innerwrapper .column__line .column .inner-video video {
    width: 100%;
    height: auto;
  }

  .section__interview-columns .innerwrapper .column__line .column .image {
    margin-top: 2rem;
  }

  .section__interview-columns .innerwrapper .column__line .column h3 {
    font-family: "AgrandirWide", sans-serif;
    font-size: var(--fontSize24);
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
  }

  @media (max-width: 768px) {
    .section__interview-columns .innerwrapper .column__line .column h3 {
      font-size: var(--fontSize17);
      line-height: 1.3;
    }
  }

  .section__interview-columns .innerwrapper .column__line .column :global(p:last-child) {
    margin-bottom: 0;
  }

  .section__interview-columns .innerwrapper .column__line .column :global(p:first-child) {
    margin-top: 0;
  }

  .section__interview-columns .innerwrapper .column__line .column :global(em) {
    font-family: "AgrandirWide", sans-serif;
    font-size: var(--fontSize14);
    font-weight: 900;
    line-height: 1.428;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-style: normal;
    display: inline-block;
    margin-right: 0.3em;
  }

  @media (max-width: 768px) {
    .section__interview-columns .innerwrapper .column__line .column :global(em) {
      font-size: var(--fontSize12);
    }
  }
</style>

<script>
  // Lazy load videos
  const lazyVideos = document.querySelectorAll('.section__interview-columns video.lazy');

  if ('IntersectionObserver' in window) {
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const video = entry.target as HTMLVideoElement;
          const source = video.querySelector('source[data-src]') as HTMLSourceElement;

          if (source && source.dataset.src) {
            source.src = source.dataset.src;
            video.load();
            video.classList.remove('lazy');
          }

          videoObserver.unobserve(video);
        }
      });
    });

    lazyVideos.forEach((video) => videoObserver.observe(video));
  }
</script>
