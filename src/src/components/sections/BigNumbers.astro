---
interface NumberItem {
  number: string;
  text: string;
}

interface Props {
  numbers: NumberItem[];
  class?: string;
}

const { numbers, class: className = '' } = Astro.props;
---

<section class:list={['section__big-numbers', 'default', className]}>
  <div class="innerwrapper">
    <div class="number__holder">
      {numbers.map((item) => (
        <div class="single__number">
          <span class="number">{item.number}</span>
          <div class="text">
            <p set:html={item.text} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section__big-numbers .innerwrapper .number__holder {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 2rem;
  }

  @media (max-width: 768px) {
    .section__big-numbers .innerwrapper .number__holder {
      grid-template-columns: 100%;
      gap: 4.5rem 0;
    }
  }

  @media (max-width: 768px) {
    .section__big-numbers .innerwrapper .number__holder .single__number {
      margin: 0 auto;
    }
  }

  .section__big-numbers .innerwrapper .number__holder .single__number .number {
    display: block;
    font-family: "AgrandirWide", sans-serif;
    font-size: var(--fontSize150);
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: 0;
    text-align: center;
  }

  @media (max-width: 768px) {
    .section__big-numbers .innerwrapper .number__holder .single__number .number {
      font-size: var(--fontSize80);
    }
  }

  .section__big-numbers .innerwrapper .number__holder .single__number .text {
    font-size: var(--fontSize14);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.2em;
    text-align: center;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .section__big-numbers .innerwrapper .number__holder .single__number .text {
      font-size: var(--fontSize11);
      max-width: 24em;
      margin-left: auto;
      margin-right: auto;
    }
  }

  .section__big-numbers .innerwrapper .number__holder .single__number .text p {
    margin-left: auto;
    margin-right: auto;
    max-width: 32em;
  }

  .section__big-numbers .innerwrapper .number__holder .single__number .text p :global(em) {
    padding: 0 0.2em;
    font-style: normal;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    background-color: var(--colorYellow);
  }

  .section__big-numbers .innerwrapper .number__holder .single__number .text p:last-child {
    margin-bottom: 0;
  }

  .section__big-numbers .innerwrapper .number__holder .single__number .text p:first-child {
    margin-top: auto;
  }
</style>
