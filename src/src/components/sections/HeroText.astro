---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section class:list={['section__hero-text', 'default', className]}>
  <div class="innerwrapper">
    <slot />
  </div>
</section>

<style>
  .section__hero-text {
    margin-top: 0 !important;
  }

  .section__hero-text .innerwrapper {
    padding-top: 3.5rem;
    font-family: "PlantinMTPro", serif;
    font-size: var(--fontSize32);
    font-weight: 300;
    line-height: 1.1875;
    letter-spacing: 0.01em;
    text-align: center;
    padding-bottom: 5.5rem;
  }

  @media (max-width: 768px) {
    .section__hero-text .innerwrapper {
      padding-top: 2.8rem;
      font-size: var(--fontSize17);
      line-height: 1.3;
      letter-spacing: 0.03em;
      padding-bottom: 2rem;
    }
  }

  .section__hero-text .innerwrapper :global(p) {
    max-width: 37em;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 768px) {
    .section__hero-text .innerwrapper :global(p) {
      max-width: calc(100% - 1rem);
    }

    .section__hero-text .innerwrapper :global(p br) {
      display: none;
    }
  }

  .section__hero-text .innerwrapper :global(h1) {
    margin: 0 0 0.7em 0;
    color: var(--colorBlack);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
  }

  @media (max-width: 768px) {
    .section__hero-text .innerwrapper :global(h1) {
      font-size: var(--fontSize22);
      margin: 0 0 0.9em 0;
      font-weight: 900;
      line-height: 1.2;
      letter-spacing: 0.03em;
      text-align: center;
    }

    .section__hero-text .innerwrapper :global(h1 br) {
      display: none;
    }
  }
</style>
