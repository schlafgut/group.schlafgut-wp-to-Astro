---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section class:list={['section__text-centered', 'default', className]}>
  <div class="innerwrapper smaller">
    <div class="content">
      <slot />
    </div>
  </div>
</section>

<style>
  .section__text-centered .innerwrapper {
    padding: 2.2rem 0;
  }

  @media (max-width: 768px) {
    .section__text-centered .innerwrapper {
      padding-left: 1.2rem;
      padding-right: 1.2rem;
    }
  }

  .section__text-centered .content {
    font-family: "PlantinMTPro", serif;
    font-size: var(--fontSize32);
    font-weight: 300;
    line-height: 1.1875;
    letter-spacing: 0.01em;
    text-align: center;
    margin: 0 auto;
    max-width: 36.5em;
  }

  @media (max-width: 768px) {
    .section__text-centered .content {
      font-size: var(--fontSize16);
      line-height: 1.4;
      text-align: left;
    }
  }

  .section__text-centered .content :global(p:first-child) {
    margin-top: 0;
  }

  .section__text-centered .content :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
