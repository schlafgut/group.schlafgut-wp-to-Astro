---
import '../styles/global.css';
import '../styles/components.css';
import { getLangFromUrl, getHreflangs, getLangHtmlAttr } from '../i18n/utils';
import { getEntry } from 'astro:content';
import Ticker from '../components/Ticker.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import AnimationLoader from '../components/AnimationLoader.astro';
import { ui } from '../i18n/navigation';

// Load ticker text from Keystatic settings
const settingsEntry = await getEntry('settings', 'index');
const tickerTextFromCMS = settingsEntry?.data?.tickerText || '';

interface Props {
  title: string;
  description?: string;
  tickerText?: string;
  /** Yellow header background for job detail pages */
  headerVariant?: 'default' | 'yellow';
}

const {
  title,
  description = '',
  tickerText = tickerTextFromCMS,
  headerVariant = 'default',
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const langHtml = getLangHtmlAttr(lang);
const hreflangs = getHreflangs(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
const t = ui[lang];
---

<!doctype html>
<html dir="ltr" lang={langHtml}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    {hreflangs.map(({ lang, href }) => (
      <link rel="alternate" href={href} hreflang={lang} />
    ))}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Slot for page-specific structured data (Schema.org) -->
    <slot name="head" />
  </head>
  <body class:list={["frontend", { "header-yellow": headerVariant === "yellow" }]}>
    {tickerText && <Ticker text={tickerText} variant="default" />}
    <Header currentPath={currentPath} />

    <div class="outerwrapper">
      <slot />
    </div>

    <Footer />

    <Button href="https://www.schlafgut.com" target="_blank" variant="shop" class="only__mobile">
      {t.shopNow}
    </Button>

    <!-- GSAP Animations - loads after page is idle -->
    <AnimationLoader />
  </body>
</html>
