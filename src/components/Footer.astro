---
import Logo from "./Logo.astro";
import { getLangFromUrl } from "../i18n/utils";
import { footerColumns, ui } from "../i18n/navigation";

const lang = getLangFromUrl(Astro.url);
const columns = footerColumns[lang];
const t = ui[lang];
---

<footer>
  <div class="innerwrapper smaller">
    <div class="footer__bottom">
      <div class="footer__columns">
        {
          columns.map((column) => (
            <div class="column">
              <ul>
                <li class="column-title">{column.title}</li>
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noopener noreferrer" : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <div class="footer__logo">
          <Logo variant="heart" />
        </div>
      </div>

      <div class="payment__logo-line">
        <img src="/images/paylogos.png" alt="Payment methods" loading="lazy" />
      </div>

      <div class="tax-information">{t.taxInfo}</div>
    </div>
  </div>
</footer>
