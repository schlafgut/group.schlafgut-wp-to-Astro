---
import { getLangFromUrl, getLocalizedUrl } from "../i18n/utils";

interface Props {
  text: string;
  href?: string;
  variant?: "default" | "yellow";
}

const { text, href, variant = "default" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const jobsHref = href || getLocalizedUrl("bei-uns-arbeiten/", lang);
---

<a href={jobsHref} class:list={["topticker", { yellow: variant === "yellow" }]}>
  <div class="ticker" id="ticker-content">
    <span class="ticker-item" set:html={text} />
  </div>
</a>

<script>
  import gsap from 'gsap';

  function initTicker() {
    const ticker = document.getElementById('ticker-content');
    if (!ticker) return;

    const originalSpan = ticker.querySelector('.ticker-item');
    if (!originalSpan) return;

    // Get viewport width and single item width
    const viewportWidth = window.innerWidth;
    const itemWidth = originalSpan.getBoundingClientRect().width;

    // Calculate how many copies we need to fill viewport + one extra set for seamless loop
    const copiesNeeded = Math.ceil((viewportWidth * 2) / itemWidth) + 2;

    // Clone the span enough times to fill the space
    for (let i = 0; i < copiesNeeded; i++) {
      const clone = originalSpan.cloneNode(true) as HTMLElement;
      ticker.appendChild(clone);
    }

    // Calculate total width of one "set" (half the content)
    const allSpans = ticker.querySelectorAll('.ticker-item');
    const halfCount = Math.floor(allSpans.length / 2);
    let halfWidth = 0;
    for (let i = 0; i < halfCount; i++) {
      halfWidth += (allSpans[i] as HTMLElement).offsetWidth;
    }

    // Seamless infinite loop
    gsap.to(ticker, {
      x: -halfWidth,
      duration: 30,
      ease: 'none',
      repeat: -1,
      modifiers: {
        x: gsap.utils.unitize((x: string) => parseFloat(x) % halfWidth)
      }
    });
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTicker);
  } else {
    initTicker();
  }
</script>

<style>
  .topticker {
    --backgroundColor: var(--colorBlack);
    --color: var(--colorWhite);
    background-color: var(--backgroundColor);
    width: 100%;
    position: relative;
    z-index: 99999;
    display: block;
    text-decoration: none;
    overflow: hidden;
  }

  .topticker.yellow {
    --backgroundColor: var(--colorYellow);
    --color: var(--colorBlack);
  }

  .ticker {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    position: relative;
    z-index: 9;
    height: var(--tickerHeight);
    width: max-content;
    /* CSS animation removed - handled by GSAP */
  }

  .ticker > :global(span) {
    padding: 0 2.3em;
    font-size: var(--fontSize12);
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: 0.3em;
    color: var(--color);
    white-space: nowrap;
    display: flex;
    gap: 0 4.6em;
    font-weight: 500;
    flex-shrink: 0;
  }

  @media only screen and (max-width: 768px) {
    .ticker > :global(span) {
      font-size: var(--fontSize9);
    }
  }

  .ticker > :global(span strong) {
    font-weight: 900;
    font-family: "AgrandirWide", sans-serif;
    letter-spacing: 0.13em;
  }
</style>
