---
import { getLangFromUrl, getLocalizedUrl } from '../i18n/utils';

interface Props {
  text: string;
  href?: string;
  variant?: 'default' | 'yellow';
}

const { text, href, variant = 'default' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const jobsHref = href || getLocalizedUrl('bei-uns-arbeiten/', lang);
---

<a href={jobsHref} class:list={['topticker', { yellow: variant === 'yellow' }]}>
  <div class="ticker">
    {Array(7).fill(null).map(() => (
      <span set:html={text} />
    ))}
  </div>
</a>

<style>
  .topticker {
    --backgroundColor: var(--colorBlack);
    --color: var(--colorWhite);
    background-color: var(--backgroundColor);
    width: 100%;
    position: relative;
    z-index: 99999;
    display: block;
    text-decoration: none;
  }

  .topticker.yellow {
    --backgroundColor: var(--colorYellow);
    --color: var(--colorBlack);
  }

  .ticker {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    position: relative;
    z-index: 9;
    height: var(--tickerHeight);
    overflow: hidden;
    width: 100%;
    animation: ticker 30s linear infinite;
  }

  .ticker > :global(span) {
    padding: 0 2.3em;
    font-size: var(--fontSize12);
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: 0.3em;
    color: var(--color);
    white-space: nowrap;
    display: flex;
    gap: 0 4.6em;
    font-weight: 500;
    flex-shrink: 0;
  }

  @media only screen and (max-width: 768px) {
    .ticker > :global(span) {
      font-size: var(--fontSize9);
    }
  }

  .ticker > :global(span strong) {
    font-weight: 900;
    font-family: "AgrandirWide", sans-serif;
    letter-spacing: 0.13em;
  }

  @keyframes ticker {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
