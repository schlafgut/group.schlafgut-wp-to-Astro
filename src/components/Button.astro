---
interface Props {
  href: string;
  target?: '_blank' | '_self';
  variant?: 'default' | 'shop';
  class?: string;
}

const { href, target = '_self', variant = 'default', class: className = '' } = Astro.props;
const classes = [
  'cta__button',
  variant === 'shop' ? 'shop__button' : '',
  className,
].filter(Boolean).join(' ');
---

<a href={href} target={target} class={classes}>
  <slot />
</a>

<style>
  .cta__button {
    font-size: var(--fontSize12);
    line-height: 1.3;
    border: 1px solid var(--colorBlack);
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--colorBlack);
    padding: 0.7em 2em;
    border-radius: 1.5em;
    font-weight: 500;
    text-decoration: none;
    display: inline-block;
    transition: background-color 200ms ease-out, color 200ms ease-out;
  }

  .cta__button:hover {
    background-color: var(--colorBlack);
    color: var(--colorWhite);
  }

  .cta__button.shop__button.only__mobile {
    position: fixed;
    right: var(--sideSpacing);
    bottom: var(--sideSpacing);
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(0.1rem);
    z-index: 98;
    font-size: var(--fontSize9);
  }
</style>
