---
import { getLangFromUrl } from "../i18n/utils";
import { navigation } from "../i18n/navigation";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const navItems = navigation[lang];

function isCurrentPage(href: string, current: string): boolean {
  // Normalize paths
  const normalizedHref = href.endsWith("/") ? href : href + "/";
  const normalizedCurrent = current.endsWith("/") ? current : current + "/";
  return normalizedHref === normalizedCurrent;
}
---

<nav>
  <div class="innerwrapper smaller">
    <ul class="menu">
      {
        navItems.map((item) => (
          <li
            class:list={[
              "menu-item",
              { "current-menu-item": isCurrentPage(item.href, currentPath) },
            ]}
          >
            <a
              href={item.href}
              aria-current={
                isCurrentPage(item.href, currentPath) ? "page" : undefined
              }
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
<script is:inline>
  const burger = document.querySelector(".burger");
  const navs = document.querySelectorAll("nav");

  if (burger && navs.length) {
    burger.addEventListener("click", () => {
      // toggle navs
      navs.forEach((nav) => {
        nav.classList.toggle("is-active");
      });

      // toggle burger itself
      burger.classList.toggle("is-active");
    });
  }
</script>
