---
/**
 * Image component with Astro's native image optimization
 *
 * Features:
 * - Automatic WebP conversion
 * - Responsive image generation (srcset)
 * - Native lazy loading (loading="lazy")
 * - CLS prevention via width/height attributes
 *
 * Target: Lighthouse Performance 95+
 */
import { Image as AstroImage } from "astro:assets";

interface Props {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
  srcset?: string; // Legacy prop, ignored with optimization
  sizes?: string;
  class?: string;
  loading?: "lazy" | "eager";
}

const {
  src,
  alt = "",
  width,
  height,
  class: className = "",
  loading = "lazy",
  sizes = "(max-width: 768px) 100vw, 50vw",
} = Astro.props;

// Extract filename from wp-content path
const getFilename = (path: string): string => path.split("/").pop() || "";

// Import all images from assets folder at build time (lazy loaded)
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{jpg,jpeg,png,gif,webp}"
);

// Get the image module for this src
const filename = getFilename(src);
const imagePath = `/src/assets/images/${filename}`;
const imageLoader = allImages[imagePath];

// Load the image if found in assets
let imageData: ImageMetadata | null = null;
if (imageLoader) {
  const module = await imageLoader();
  imageData = module.default;
}

// Determine final dimensions
const finalWidth = width || imageData?.width;
const finalHeight = height || imageData?.height;
---

{
  imageData ? (
    <AstroImage
      src={imageData}
      alt={alt}
      width={finalWidth}
      height={finalHeight}
      class={className}
      loading={loading}
      decoding={loading === "lazy" ? "async" : "sync"}
      format="webp"
      quality={80}
      densities={[1, 2]}
    />
  ) : (
    <img
      src={src}
      alt={alt}
      width={finalWidth}
      height={finalHeight}
      class={className}
      loading={loading}
      decoding={loading === "lazy" ? "async" : "sync"}
      fetchpriority={loading === "eager" ? "high" : undefined}
    />
  )
}
