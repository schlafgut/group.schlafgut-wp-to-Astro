---
import Image from "../Image.astro";

interface VideoSource {
  src: string;
  width?: number;
  height?: number;
}

interface Props {
  variant?: "default" | "wide";
  headline?: "agrandir_wide" | "plantin";
  position?: "top" | "middle";
  color?: "black" | "white" | "yellow";
  kicker?: string;
  title?: string;
  link?: {
    href: string;
    label: string;
    target?: "_blank" | "_self";
  };
  image?: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    srcset?: string;
  };
  video?: {
    desktop?: VideoSource;
    mobile?: VideoSource;
    src?: string;
    width?: number;
    height?: number;
  };
}

const {
  variant = "default",
  headline = "agrandir_wide",
  position = "top",
  color = "black",
  kicker,
  title,
  link,
  image,
  video,
} = Astro.props;
---

<div
  class:list={["single__block", variant, "stagger-item"]}
  data-headline={headline}
  data-position={position}
  data-color={color}
>
  <div class="content">
    {kicker && <h4 class="kicker" set:html={kicker} />}
    {title && <h3 class="title" set:html={title} />}
  </div>

  {
    link && (
      <a href={link.href} target={link.target || "_self"} class="cta__link">
        {link.label}
      </a>
    )
  }

  {
    video?.desktop && video?.mobile ? (
      <>
        <video
          class="background_image only__desktop lazy"
          width={video.desktop.width}
          height={video.desktop.height}
          autoplay
          loop
          muted
          playsinline
          aria-label="Dekoratives Hintergrundvideo"
        >
          <source data-src={video.desktop.src} type="video/mp4" />
        </video>
        <video
          class="background_image only__mobile lazy"
          width={video.mobile.width}
          height={video.mobile.height}
          autoplay
          loop
          muted
          playsinline
          aria-label="Dekoratives Hintergrundvideo"
        >
          <source data-src={video.mobile.src} type="video/mp4" />
        </video>
      </>
    ) : video?.src ? (
      <video
        class="background_image lazy"
        width={video.width}
        height={video.height}
        autoplay
        loop
        muted
        playsinline
        aria-label="Dekoratives Hintergrundvideo"
      >
        <source data-src={video.src} type="video/mp4" />
      </video>
    ) : image ? (
      <Image
        src={image.src}
        alt={image.alt || ""}
        width={image.width}
        height={image.height}
        srcset={image.srcset}
        class="background_image"
      />
    ) : null
  }
</div>

<style>
  video.background_image {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    border-radius: var(--borderRadius);
  }
</style>

<script>
  // Lazy load videos
  const lazyVideos = document.querySelectorAll("video.lazy");

  if ("IntersectionObserver" in window) {
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const video = entry.target as HTMLVideoElement;
          const source = video.querySelector(
            "source[data-src]"
          ) as HTMLSourceElement;

          if (source && source.dataset.src) {
            source.src = source.dataset.src;
            video.load();
            video.classList.remove("lazy");
          }

          videoObserver.unobserve(video);
        }
      });
    });

    lazyVideos.forEach((video) => videoObserver.observe(video));
  }
</script>
