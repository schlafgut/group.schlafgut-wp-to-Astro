---
import Image from '../Image.astro';

interface Props {
  variant?: 'default' | 'wide';
  headline?: 'agrandir_wide' | 'plantin';
  position?: 'top' | 'middle';
  color?: 'black' | 'white' | 'yellow';
  kicker?: string;
  title?: string;
  link?: {
    href: string;
    label: string;
    target?: '_blank' | '_self';
  };
  image?: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    srcset?: string;
  };
  video?: {
    src: string;
    width?: number;
    height?: number;
  };
}

const {
  variant = 'default',
  headline = 'agrandir_wide',
  position = 'top',
  color = 'black',
  kicker,
  title,
  link,
  image,
  video,
} = Astro.props;
---

<div
  class:list={['single__block', variant]}
  data-headline={headline}
  data-position={position}
  data-color={color}
>
  <div class="content">
    {kicker && <h4 set:html={kicker} />}
    {title && <h3 set:html={title} />}
  </div>

  {link && (
    <a href={link.href} target={link.target || '_self'} class="cta__link">
      {link.label}
    </a>
  )}

  {video ? (
    <video class="background_image lazy" width={video.width} height={video.height} autoplay loop muted playsinline>
      <source data-src={video.src} type="video/mp4" />
    </video>
  ) : image ? (
    <Image
      src={image.src}
      alt={image.alt || ''}
      width={image.width}
      height={image.height}
      srcset={image.srcset}
      class="background_image"
    />
  ) : null}
</div>

<style>
  .single__block {
    --color: var(--colorBlack);
    position: relative;
    overflow: hidden;
    border-radius: var(--borderRadius);
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 61rem;
  }

  @media (max-width: 768px) {
    .single__block {
      height: 27.9rem;
    }
  }

  .single__block.wide {
    grid-column: 1 / 3;
    height: 48.6rem;
  }

  @media (max-width: 768px) {
    .single__block.wide {
      grid-column: unset;
      height: 35.6rem;
      width: calc(100% + var(--sideSpacing) + var(--sideSpacing));
      margin-left: calc(var(--sideSpacing) * -1);
      margin-right: calc(var(--sideSpacing) * -1);
      border-radius: 0;
    }

    .single__block.wide:not(:first-child) {
      margin-top: 3.2rem;
    }

    .single__block.wide:not(:last-child) {
      margin-bottom: 3.2rem;
    }
  }

  /* Position variants */
  .single__block[data-position="top"] .content {
    margin-bottom: auto;
  }

  .single__block[data-position="middle"] .content {
    margin-bottom: auto !important;
    margin-top: auto !important;
  }

  @media (max-width: 768px) {
    .single__block[data-position="middle"] .content {
      padding-left: 2rem;
      padding-right: 2rem;
    }

    .single__block[data-position="middle"] .content h3 {
      margin-top: 0.8rem !important;
    }
  }

  /* Color variants */
  .single__block[data-color="black"] {
    --color: var(--colorBlack);
  }

  .single__block[data-color="white"] {
    --color: var(--colorWhite);
  }

  .single__block[data-color="yellow"] {
    --color: var(--colorYellow);
  }

  .content {
    margin-top: 3.8rem;
    padding-bottom: 3rem;
    position: relative;
    z-index: 5;
    text-align: center;
    color: var(--color);
  }

  @media (max-width: 768px) {
    .content {
      margin-top: 1.8rem;
    }
  }

  .content h4 {
    margin: 0;
    font-family: "Agrandir", sans-serif;
    font-style: normal;
    font-weight: 500;
    font-size: var(--fontSize16);
    line-height: 1.3125;
    text-align: center;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color);
    margin-bottom: 3.4em;
  }

  .content h4 br {
    display: none;
  }

  @media (max-width: 768px) {
    .content h4 {
      font-size: var(--fontSize11);
      line-height: 1.45;
      margin-bottom: 2em;
    }

    .content h4 br {
      display: block;
    }
  }

  .content h3 {
    font-family: "PlantinMTPro", serif;
    margin: 0;
    font-weight: 300;
    font-size: var(--fontSize60);
    line-height: 1;
    color: var(--color);
  }

  @media (max-width: 768px) {
    .content h3 {
      font-size: var(--fontSize32);
      line-height: 1.1;
      max-width: calc(100% - var(--sideSpacing) - var(--sideSpacing) - var(--sideSpacing) - var(--sideSpacing));
      margin-left: auto;
      margin-right: auto;
    }

    .content h3 br {
      display: none;
    }
  }

  /* Headline font variants */
  .single__block[data-headline="agrandir_wide"] h3 {
    font-family: "AgrandirWide", sans-serif;
    font-size: var(--fontSize45);
    font-weight: 900;
    line-height: 1.11;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: -0.15em;
  }

  @media (max-width: 768px) {
    .single__block[data-headline="agrandir_wide"] h3 {
      font-size: var(--fontSize24);
      line-height: 1.125;
    }
  }

  .single__block[data-headline="plantin"] h3 {
    font-family: "PlantinMTPro", serif;
  }

  /* Wide variants with specific headline styles */
  .single__block.wide[data-headline="plantin"] h3 {
    font-size: var(--fontSize94);
  }

  @media (max-width: 768px) {
    .single__block.wide[data-headline="plantin"] h3 {
      font-size: var(--fontSize50);
    }
  }

  .single__block.wide[data-headline="agrandir_wide"] h3 {
    font-size: var(--fontSize52);
    margin-top: -0.15em;
  }

  @media (max-width: 768px) {
    .single__block.wide[data-headline="agrandir_wide"] h3 {
      font-size: var(--fontSize34);
      line-height: 1.176;
    }
  }

  .cta__link {
    font-size: var(--fontSize16);
    line-height: 1.3125;
    color: var(--color);
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    letter-spacing: 0.26em;
    bottom: 5.4rem;
    z-index: 5;
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .cta__link {
      font-size: var(--fontSize11);
      bottom: 1.9rem;
      white-space: nowrap;
    }

    .single__block.wide .cta__link {
      bottom: 3.2rem;
    }
  }

  .cta__link::before {
    content: '';
    display: block;
    position: absolute;
    left: 0;
    bottom: -0.2em;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transition: width 200ms ease-out;
  }

  .cta__link:hover::before {
    width: 0;
  }

  .single__block :global(.background_image) {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    border-radius: var(--borderRadius);
  }

  video.background_image {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    border-radius: var(--borderRadius);
  }
</style>

<script>
  // Lazy load videos
  const lazyVideos = document.querySelectorAll('video.lazy');

  if ('IntersectionObserver' in window) {
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const video = entry.target as HTMLVideoElement;
          const source = video.querySelector('source[data-src]') as HTMLSourceElement;

          if (source && source.dataset.src) {
            source.src = source.dataset.src;
            video.load();
            video.classList.remove('lazy');
          }

          videoObserver.unobserve(video);
        }
      });
    });

    lazyVideos.forEach((video) => videoObserver.observe(video));
  }
</script>
