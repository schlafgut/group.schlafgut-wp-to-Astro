---
import Image from '../Image.astro';

interface GridItem {
  type: 'text' | 'image';
  area: string;
  content?: string;
  image?: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    srcset?: string;
  };
}

interface Props {
  items: GridItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<section class:list={['section__image-grid', 'default', className]}>
  <div class="innerwrapper">
    <div class="grid__holder">
      {items.map((item) => (
        <div class={item.type} style={`grid-area: ${item.area};`}>
          {item.type === 'text' && item.content && (
            <p set:html={item.content} />
          )}
          {item.type === 'image' && item.image && (
            <Image
              src={item.image.src}
              alt={item.image.alt || ''}
              width={item.image.width}
              height={item.image.height}
              srcset={item.image.srcset}
            />
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section__image-grid {
    background-color: var(--colorYellow);
  }

  @media (max-width: 768px) {
    .section__image-grid {
      margin-top: -6.6rem !important;
      padding-top: 2rem;
    }
  }

  .section__image-grid .innerwrapper {
    padding-top: 7rem;
    padding-bottom: 6.5rem;
  }

  @media (max-width: 768px) {
    .section__image-grid .innerwrapper {
      padding-top: 0;
      padding-bottom: 0.5rem;
    }
  }

  .section__image-grid .innerwrapper .grid__holder {
    display: grid;
    grid-template-columns: 2.5rem 39.3rem 4rem 5.7rem 8rem 1fr;
    grid-template-rows: 43rem 6rem 47.2rem 16.9rem 11.7rem 8.6rem 17.2rem 24.1rem 1fr;
    grid-template-areas:
      "text1 text1 image1 image1 image1 image1"
      ". image2 image2 . . ."
      ". image2 image2 . . image3"
      ". image2 image2 . . image4"
      "text2 text2 . . . image4"
      "image5 image5 image5 image5 . ."
      "image5 image5 image5 image5 . text3"
      "image5 image5 image5 image5 . image6"
      "text4 text4 . . . image6";
    max-width: 94.4rem;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 768px) {
    .section__image-grid .innerwrapper .grid__holder {
      grid-template-columns: 100%;
      grid-template-rows: auto;
      grid-template-areas:
        "text1"
        "image1"
        "image2"
        "text2"
        "image4"
        "text3"
        "image5"
        "image6"
        "text4";
    }
  }

  .section__image-grid .innerwrapper .grid__holder .text {
    font-size: var(--fontSize24);
    font-weight: 400;
    line-height: 1.25;
    text-align: left;
    font-family: "PlantinMTPro", serif;
  }

  @media (max-width: 768px) {
    .section__image-grid .innerwrapper .grid__holder .text {
      font-size: var(--fontSize17);
      line-height: 1.411;
    }

    .section__image-grid .innerwrapper .grid__holder .text:first-child {
      margin-bottom: 2.2rem;
    }

    .section__image-grid .innerwrapper .grid__holder .text:not(:first-child) {
      margin-top: 2.2rem;
      margin-bottom: 2.2rem;
    }
  }

  .section__image-grid .innerwrapper .grid__holder .text p {
    margin: 0;
  }

  .section__image-grid .innerwrapper .grid__holder .image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
