---
import Image from "../Image.astro";

interface GridItem {
  type: "text" | "image";
  area: string;
  content?: string;
  image?: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    srcset?: string;
  };
}

interface Props {
  items: GridItem[];
  class?: string;
  /** Enable staggered slide-in animation */
  animate?: boolean;
}

const { items, class: className = "", animate = true } = Astro.props;
---

<section class:list={["section__image-grid", "default", className]}>
  <div class="innerwrapper">
    <div class:list={["grid__holder", { "image-row-animate": animate }]}>
      {
        items.map((item) => (
          <div class:list={[item.type, { image: item.type === "image" }]} style={`grid-area: ${item.area};`}>
            {item.type === "text" && item.content && (
              <p set:html={item.content} />
            )}
            {item.type === "image" && item.image && (
              <Image
                src={item.image.src}
                alt={item.image.alt || ""}
                width={item.image.width}
                height={item.image.height}
                srcset={item.image.srcset}
              />
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
