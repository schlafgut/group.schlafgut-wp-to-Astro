---
import Image from "../Image.astro";

interface GridItem {
  type: "text" | "image";
  area: string;
  content?: string;
  image?: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    srcset?: string;
  };
}

interface Props {
  items: GridItem[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
---

<section class:list={["section__image-grid", "default", className]}>
  <div class="innerwrapper">
    <div class="grid__holder">
      {
        items.map((item) => (
          <div class={item.type} style={`grid-area: ${item.area};`}>
            {item.type === "text" && item.content && (
              <p set:html={item.content} />
            )}
            {item.type === "image" && item.image && (
              <Image
                src={item.image.src}
                alt={item.image.alt || ""}
                width={item.image.width}
                height={item.image.height}
                srcset={item.image.srcset}
              />
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
