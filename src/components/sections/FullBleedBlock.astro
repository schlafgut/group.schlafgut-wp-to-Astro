---
import Image from "../Image.astro";

interface Props {
  href: string;
  target?: "_blank" | "_self";
  style?: "style1" | "style2";
  title?: string;
  description?: string;
  quote?: string;
  author?: string;
  linkLabel?: string;
  image?: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    srcset?: string;
  };
}

const {
  href,
  target = "_self",
  style = "style1",
  title,
  description,
  quote,
  author,
  linkLabel,
  image,
} = Astro.props;
---

<a
  href={href}
  target={target}
  class:list={["single__bleed-block", style, "slideInElement"]}
>
  <div class="content">
    {title && <h4 set:html={title} />}
    {description && <p set:html={description} />}
    {quote && <p class="quote" set:html={quote} />}
    {author && <p class="author" set:html={author} />}
    {linkLabel && <span class="link-label">{linkLabel}</span>}
  </div>
  {
    image && (
      <div class="image">
        <Image
          src={image.src}
          alt={image.alt || ""}
          width={image.width}
          height={image.height}
          srcset={image.srcset}
        />
      </div>
    )
  }
</a>
