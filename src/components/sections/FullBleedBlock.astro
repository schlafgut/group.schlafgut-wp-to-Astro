---
import Image from '../Image.astro';

interface Props {
  href: string;
  target?: '_blank' | '_self';
  style?: 'style1' | 'style2';
  title?: string;
  description?: string;
  quote?: string;
  author?: string;
  linkLabel?: string;
  image?: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    srcset?: string;
  };
}

const {
  href,
  target = '_self',
  style = 'style1',
  title,
  description,
  quote,
  author,
  linkLabel,
  image,
} = Astro.props;
---

<a href={href} target={target} class:list={['single__bleed-block', style, 'slideInElement']}>
  <div class="content">
    {title && <h4 set:html={title} />}
    {description && <p set:html={description} />}
    {quote && <p class="quote" set:html={quote} />}
    {author && <p class="author" set:html={author} />}
    {linkLabel && <span class="link-label">{linkLabel}</span>}
  </div>
  {image && (
    <div class="image">
      <Image
        src={image.src}
        alt={image.alt || ''}
        width={image.width}
        height={image.height}
        srcset={image.srcset}
      />
    </div>
  )}
</a>

<style>
  .single__bleed-block {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
    width: calc(100% + 2px);
    margin-left: -1px;
    margin-right: -1px;
  }

  .single__bleed-block .content {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 9;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .single__bleed-block h4 {
    font-family: "Agrandir", sans-serif;
    font-size: var(--fontSize18);
    font-weight: 500;
    line-height: 1.444;
    letter-spacing: 0.26em;
    text-align: center;
    margin: 0;
    color: var(--colorWhite);
    text-transform: uppercase;
    position: relative;
  }

  @media (max-width: 768px) {
    .single__bleed-block h4 {
      font-size: var(--fontSize12);
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
  }

  .single__bleed-block h4::before {
    content: '';
    display: block;
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--colorWhite);
    bottom: -0.1em;
    transition: width 200ms ease-out;
  }

  @media (max-width: 768px) {
    .single__bleed-block h4::before {
      display: none;
    }
  }

  .single__bleed-block:hover h4::before {
    width: 0;
  }

  /* Style 2 variations */
  .single__bleed-block.style2 h4 {
    text-align: left;
    font-size: var(--fontSize14);
    color: var(--colorBlack);
  }

  @media (max-width: 768px) {
    .single__bleed-block.style2 h4 {
      font-size: var(--fontSize7);
    }
  }

  .single__bleed-block.style2 h4::before {
    background-color: var(--colorBlack);
  }

  .single__bleed-block.style2 .content {
    align-items: flex-start;
    justify-content: flex-start;
    padding: 1.5rem 1rem;
    text-align: left;
  }

  @media (max-width: 768px) {
    .single__bleed-block.style2 .content {
      padding: 0.7rem;
    }
  }

  .single__bleed-block.style2 .content p {
    font-family: "PlantinMTPro", serif;
    font-size: var(--fontSize20);
    line-height: 1.2;
    margin: 0;
  }

  @media (max-width: 768px) {
    .single__bleed-block.style2 .content p {
      font-size: var(--fontSize11);
    }
  }

  .single__bleed-block.style2 .content .quote {
    font-family: "PlantinMTPro", serif;
    font-size: var(--fontSize36);
    font-weight: 300;
    line-height: 1.15;
    margin: 0 0 1rem 0;
    max-width: 80%;
  }

  @media (max-width: 768px) {
    .single__bleed-block.style2 .content .quote {
      font-size: var(--fontSize17);
      max-width: 90%;
    }
  }

  .single__bleed-block.style2 .content .author {
    font-family: "Agrandir", sans-serif;
    font-size: var(--fontSize12);
    font-weight: 400;
    line-height: 1.4;
    margin: 0 0 1.5rem 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .single__bleed-block.style2 .content .author {
      font-size: var(--fontSize9);
      margin-bottom: 1rem;
    }
  }

  .single__bleed-block.style2 .content .link-label {
    font-family: "Agrandir", sans-serif;
    font-size: var(--fontSize14);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    position: relative;
    display: inline-block;
  }

  @media (max-width: 768px) {
    .single__bleed-block.style2 .content .link-label {
      font-size: var(--fontSize10);
    }
  }

  .single__bleed-block.style2 .content .link-label::after {
    content: '';
    display: block;
    position: absolute;
    left: 0;
    bottom: -0.15em;
    width: 100%;
    height: 1px;
    background-color: var(--colorBlack);
    transition: width 200ms ease-out;
  }

  .single__bleed-block.style2:hover .content .link-label::after {
    width: 0;
  }

  /* Image styles */
  .single__bleed-block .image {
    position: relative;
    z-index: 0;
    overflow: hidden;
  }

  .single__bleed-block .image :global(img) {
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0) scale(1.04);
    transition: filter 200ms ease-out;
    will-change: transform;
    width: 100%;
    height: auto;
  }

  @media (hover: hover) {
    .single__bleed-block:hover .image :global(img) {
      filter: blur(0.4rem);
    }
  }
</style>
