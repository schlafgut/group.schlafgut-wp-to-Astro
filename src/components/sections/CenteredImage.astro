---
import Image from "../Image.astro";

interface Props {
  image: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    srcset?: string;
  };
  description?: string;
  class?: string;
}

const { image, description, class: className = "" } = Astro.props;
---

<section class:list={["section__centered-image", "default", className]}>
  <div class="innerwrapper">
    <div class="image">
      <Image
        src={image.src}
        alt={image.alt || ""}
        width={image.width}
        height={image.height}
        srcset={image.srcset}
      />
      {
        description && (
          <div class="description">
            <p set:html={description} />
          </div>
        )
      }
    </div>
  </div>
</section>
