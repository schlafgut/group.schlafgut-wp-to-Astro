---
interface Props {
  size?: 'small' | 'medium' | 'large' | 'xlarge';
}

const { size = 'medium' } = Astro.props;
---

<section class:list={['spacer', size]}></section>

<style>
  .spacer {
    display: block;
  }

  .spacer.small {
    height: calc(var(--sectionSpacing) * 0.5);
  }

  .spacer.medium {
    height: var(--sectionSpacing);
  }

  .spacer.large {
    height: calc(var(--sectionSpacing) * 1.5);
  }

  .spacer.xlarge {
    height: calc(var(--sectionSpacing) * 2);
  }

  @media (max-width: 768px) {
    .spacer.small {
      height: calc(var(--sectionSpacing) * 0.5);
    }

    .spacer.medium {
      height: var(--sectionSpacing);
    }

    .spacer.large {
      height: calc(var(--sectionSpacing) * 1.25);
    }

    .spacer.xlarge {
      height: calc(var(--sectionSpacing) * 1.5);
    }
  }
</style>
