---
import Image from '../Image.astro';

interface Props {
  reversed?: boolean;
  fullBleed?: boolean;
  noMargin?: boolean;
  background?: 'default' | 'yellow' | 'beige';
  content: string;
  image?: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    srcset?: string;
  };
  video?: {
    src: string;
    width?: number;
    height?: number;
  };
  class?: string;
}

const {
  reversed = false,
  fullBleed = false,
  noMargin = false,
  background = 'default',
  content,
  image,
  video,
  class: className = '',
} = Astro.props;

const classes = [
  'section__text-image',
  reversed && 'reversed',
  fullBleed && 'full-bleed',
  noMargin ? 'no-margin' : 'default',
  className,
].filter(Boolean);
---

<section
  class:list={classes}
  data-background={background}
>
  <div class="innerwrapper">
    <div class="content">
      <Fragment set:html={content} />
    </div>
    <div class="image">
      {video ? (
        <video
          class="lazy"
          width={video.width || 1080}
          height={video.height || 1080}
          autoplay
          loop
          muted
          playsinline
        >
          <source data-src={video.src} type="video/mp4" />
        </video>
      ) : image ? (
        <Image
          src={image.src}
          alt={image.alt || ''}
          width={image.width}
          height={image.height}
          srcset={image.srcset}
        />
      ) : null}
    </div>
  </div>
</section>

<style>
  .section__text-image .innerwrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    text-align: left;
    align-items: center;
  }

  @media (max-width: 768px) {
    .section__text-image .innerwrapper {
      grid-template-columns: 100%;
      gap: 1.5rem 0;
    }
  }

  .section__text-image .innerwrapper .content {
    font-family: "PlantinMTPro", serif;
    font-size: var(--fontSize24);
    font-weight: 300;
    line-height: 1.25;
    text-align: left;
  }

  @media (max-width: 768px) {
    .section__text-image .innerwrapper .content {
      order: 2;
      font-size: var(--fontSize17);
      line-height: 1.43;
    }
  }

  .section__text-image .innerwrapper .content :global(h2) {
    max-width: 22em;
    margin: 0;
    font-family: "AgrandirWide", sans-serif;
    font-weight: 900;
    font-size: var(--fontSize24);
    text-transform: uppercase;
    line-height: 1.2;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .section__text-image .innerwrapper .content :global(h2) {
      margin-bottom: 2.1em;
      font-size: var(--fontSize17);
    }
  }

  .section__text-image .innerwrapper .content :global(p:first-child) {
    margin-top: 0;
  }

  .section__text-image .innerwrapper .content :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .section__text-image .innerwrapper .image {
      order: 1;
    }
  }

  .section__text-image .innerwrapper .image :global(img),
  .section__text-image .innerwrapper .image :global(video) {
    margin-left: -5rem;
    display: block;
    margin-right: auto;
    max-width: calc(100% + 5rem);
  }

  @media (max-width: 768px) {
    .section__text-image .innerwrapper .image :global(img),
    .section__text-image .innerwrapper .image :global(video) {
      margin-left: 0;
      max-width: 100%;
    }
  }

  /* Reversed variant */
  .section__text-image.reversed .innerwrapper .image {
    order: 2;
  }

  @media (max-width: 768px) {
    .section__text-image.reversed .innerwrapper .image {
      order: 1;
    }
  }

  .section__text-image.reversed .innerwrapper .image :global(img),
  .section__text-image.reversed .innerwrapper .image :global(video) {
    margin-right: -5rem;
    margin-left: auto;
  }

  @media (max-width: 768px) {
    .section__text-image.reversed .innerwrapper .image :global(img),
    .section__text-image.reversed .innerwrapper .image :global(video) {
      margin-right: 0;
    }
  }

  .section__text-image.reversed .innerwrapper .content {
    order: 1;
  }

  @media (max-width: 768px) {
    .section__text-image.reversed .innerwrapper .content {
      order: 2;
    }
  }

  /* Full-bleed variant */
  .section__text-image.full-bleed[data-background="yellow"] {
    background-color: var(--colorYellow);
  }

  .section__text-image.full-bleed[data-background="beige"] {
    background-color: var(--colorBeige);
  }

  .section__text-image.full-bleed .innerwrapper .image {
    width: calc(100% + var(--sideSpacingWide));
    margin-left: calc(var(--sideSpacingWide) * -1);
  }

  .section__text-image.full-bleed .innerwrapper .image :global(img) {
    margin-right: 0;
    margin-left: 0;
    max-width: 100%;
  }

  @media (max-width: 768px) {
    .section__text-image.full-bleed .innerwrapper .image {
      display: none;
    }
  }

  .section__text-image.full-bleed .innerwrapper .content {
    padding-right: 0;
    padding-left: var(--sideSpacingWide);
  }

  @media (max-width: 768px) {
    .section__text-image.full-bleed .innerwrapper .content {
      padding-left: 0;
      padding-top: 4.8rem;
      padding-bottom: 4.7rem;
    }
  }
</style>
