---
interface NumberItem {
  number: string;
  text: string;
}

interface Props {
  numbers: NumberItem[];
  class?: string;
}

const { numbers, class: className = "" } = Astro.props;
---

<section class:list={["section__big-numbers", "default", className]}>
  <div class="innerwrapper">
    <div class="number__holder">
      {
        numbers.map((item) => (
          <div class="single__number">
            <span class="number">{item.number}</span>
            <div class="text">
              <p set:html={item.text} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
