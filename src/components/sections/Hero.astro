---
import Image from '../Image.astro';

interface Props {
  title: string;
  image: {
    src: string;
    alt?: string;
    width?: number;
    height?: number;
    srcset?: string;
  };
  /** First hero on page should use eager loading for LCP optimization */
  isFirstHero?: boolean;
}

const { title, image, isFirstHero = true } = Astro.props;
---

<section class="section__hero default">
  <div class="innerwrapper">
    <h1 set:html={title} />
  </div>
  <div class="image">
    <Image
      src={image.src}
      alt={image.alt || ''}
      width={image.width}
      height={image.height}
      loading={isFirstHero ? 'eager' : 'lazy'}
    />
  </div>
</section>

<style>
  .section__hero {
    position: relative;
  }

  .section__hero .innerwrapper {
    height: 100%;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 5;
  }

  .section__hero h1 {
    color: var(--colorWhite);
    text-align: center;
    font-size: var(--fontSize70);
    line-height: 1;
    margin: 0;
  }

  @media (max-width: 768px) {
    .section__hero h1 {
      margin-top: 1.2rem;
      line-height: 1.125;
      font-size: var(--fontSize24);
    }
  }

  .section__hero .image {
    position: relative;
    z-index: 0;
    width: 100%;
    height: calc(100vh - var(--headerHeight) - var(--tickerHeight) - 5.4rem);
  }

  .section__hero .image :global(img),
  .section__hero .image :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .section__hero .image {
      height: calc(100svh - var(--headerHeight) - var(--tickerHeight) - 3.4rem);
    }
  }
</style>
